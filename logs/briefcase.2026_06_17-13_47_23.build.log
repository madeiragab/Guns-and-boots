description = "A tactical combat game"
license = "MIT"
license-files = ["LICENSE"]
requires-python = ">=3.9"
dependencies = [
    "pygame>=2.1.0",
]

[tool.briefcase]
project_name = "Guns and Boots"
bundle = "com.gunsandboots"
version = "1.0.0"
description = "A tactical combat game"

[tool.briefcase.app.gunsandboots]
